# Port the bridge HTTP API listens on
PORT=3025

# Shared secret between Chatwoot and the bridge. Must match Chatwoot's WHATSAPP_BRIDGE_TOKEN.
BRIDGE_TOKEN=change-me-to-a-long-random-string

# Chatwoot base URL the bridge posts inbound messages/status to
CHATWOOT_URL=http://localhost:3000

# Directory where Baileys auth state is persisted (one folder per inbox). Keep this on a persistent volume.
AUTH_DIR=./sessions

# Label shown in the customer's "linked devices" list
BRIDGE_BROWSER_NAME=Wintouch CRM

# Log level (info|debug|warn|error)
LOG_LEVEL=info
