<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= @exhibition.name %> — Invitation</title>
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
      background: linear-gradient(160deg, #f5f3ff 0%, #eef2ff 45%, #ffffff 100%);
      color: #1e1b2e;
      min-height: 100vh;
    }
    .wrap { max-width: 640px; margin: 0 auto; padding: 32px 20px 64px; }
    .card {
      background: rgba(255,255,255,0.85);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(139,92,246,0.18);
      border-radius: 24px;
      box-shadow: 0 20px 60px rgba(99,102,241,0.12);
      overflow: hidden;
    }
    .hero {
      background: linear-gradient(135deg, #6d5efc 0%, #8b5cf6 60%, #a78bfa 100%);
      color: #fff;
      padding: 36px 28px 30px;
    }
    .hero .from { font-size: 13px; opacity: 0.85; letter-spacing: 0.04em; text-transform: uppercase; }
    .hero h1 { margin: 10px 0 6px; font-size: 26px; line-height: 1.25; font-weight: 700; }
    .hero .meta { margin-top: 14px; font-size: 14px; line-height: 1.9; opacity: 0.95; }
    .hero .meta b { font-weight: 600; }
    .badge {
      display: inline-block; margin-top: 16px; padding: 7px 14px; border-radius: 999px;
      background: rgba(255,255,255,0.22); font-size: 13px; font-weight: 600; letter-spacing: 0.02em;
    }
    .body { padding: 26px 28px 30px; }
    .intro { font-size: 15px; line-height: 1.7; color: #3a3550; margin: 0 0 22px; }
    label { display: block; font-size: 13px; font-weight: 600; color: #4a4560; margin: 16px 0 6px; }
    label .req { color: #e11d48; }
    input, textarea {
      width: 100%; padding: 11px 13px; border: 1px solid #ddd6fe; border-radius: 12px;
      font-size: 15px; background: #fff; color: #1e1b2e; font-family: inherit;
    }
    input:focus, textarea:focus { outline: none; border-color: #8b5cf6; box-shadow: 0 0 0 3px rgba(139,92,246,0.15); }
    textarea { min-height: 76px; resize: vertical; }
    .btn {
      margin-top: 24px; width: 100%; padding: 14px; border: none; border-radius: 14px; cursor: pointer;
      background: linear-gradient(135deg, #6d5efc, #8b5cf6); color: #fff; font-size: 16px; font-weight: 700;
      box-shadow: 0 10px 26px rgba(109,94,252,0.35); transition: transform .08s ease;
    }
    .btn:active { transform: translateY(1px); }
    .ok { text-align: center; padding: 48px 28px; }
    .ok .tick {
      width: 68px; height: 68px; margin: 0 auto 18px; border-radius: 50%;
      background: linear-gradient(135deg, #6d5efc, #8b5cf6); color: #fff;
      font-size: 34px; line-height: 68px; text-align: center;
    }
    .ok h2 { margin: 0 0 8px; font-size: 22px; }
    .ok p { color: #4a4560; font-size: 15px; line-height: 1.7; margin: 0; }
    .foot { text-align: center; color: #8b86a3; font-size: 12px; margin-top: 22px; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="hero">
        <div class="from"><%= @invite.account.name %> sincerely invites you</div>
        <h1><%= @exhibition.name %></h1>
        <div class="meta">
          <% if @exhibition.starts_on %>
            <div>📅 <b><%= @exhibition.starts_on.strftime('%b %d, %Y') %><%= " – #{@exhibition.ends_on.strftime('%b %d, %Y')}" if @exhibition.ends_on %></b></div>
          <% end %>
          <% loc = [@exhibition.venue, @exhibition.city, @exhibition.country].reject(&:blank?).join(', ') %>
          <% if loc.present? %><div>📍 <%= loc %></div><% end %>
          <% if @exhibition.featured_products.present? %><div>🏷️ <%= @exhibition.featured_products %></div><% end %>
        </div>
        <% if @exhibition.booth_no.present? %>
          <span class="badge">Booth <%= @exhibition.booth_no %><%= " · #{@exhibition.hall}" if @exhibition.hall.present? %></span>
        <% end %>
      </div>

      <% if @confirmed %>
        <div class="ok">
          <div class="tick">✓</div>
          <h2>Thank you — see you there!</h2>
          <p>Your visit has been confirmed. Our team will reach out with the final details before the show.</p>
        </div>
      <% else %>
        <div class="body">
          <p class="intro">We would be honored to welcome you at our booth. Please confirm your visit below and let us know what interests you most.</p>
          <form method="post" action="<%= confirm_crm_exhibition_invite_path(@invite.confirm_token) %>">
            <label>Company <span class="req">*</span></label>
            <input type="text" name="reply_company" required value="<%= @invite.customer.name %>" />

            <label>Your Name <span class="req">*</span></label>
            <input type="text" name="reply_name" required value="<%= @invite.customer.primary_contact_name %>" />

            <label>Contact (Email / WhatsApp) <span class="req">*</span></label>
            <input type="text" name="reply_contact" required value="<%= @invite.customer.contact_email.presence || @invite.customer.whats_app %>" />

            <label>Interested Products</label>
            <input type="text" name="reply_products" placeholder="e.g. Industrial displays, tablets…" />

            <label>Planned Visit Date</label>
            <input type="date" name="reply_visit_date"
                   min="<%= @exhibition.starts_on %>" max="<%= @exhibition.ends_on %>"
                   value="<%= @exhibition.starts_on %>" />

            <label>Message</label>
            <textarea name="reply_note" placeholder="Anything you'd like us to prepare"></textarea>

            <button type="submit" class="btn">Confirm Attendance</button>
          </form>
        </div>
      <% end %>
    </div>
    <div class="foot">Powered by <%= @invite.account.name %> · CRM</div>
  </div>
</body>
</html>
